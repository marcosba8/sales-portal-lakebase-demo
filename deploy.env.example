# Sales Pipeline Portal v2 — per-workspace deploy config.
#
# Copy to deploy.env and fill in for your workspace, then run:
#   ./scripts/deploy-v2.sh
#
# CLI flags (e.g. --app-name) override anything set here.

# Databricks CLI profile authenticated to the target workspace.
PROFILE="my-workspace-profile"

# Name for the Databricks App (created if it doesn't exist).
APP_NAME="sales-portal-v2"

# Lakebase Autoscaling project id (created by the demo notebook/CLI beforehand,
# or by you). The app connects to its production branch 'primary' endpoint.
LAKEBASE_PROJECT_ID="sales-db-v2"

# SQL warehouse id used by Act 4 to build/re-score the gold Delta table.
# REQUIRED — find it with: databricks warehouses list --profile <PROFILE>
# The deploy binds this warehouse to the app (CAN_USE) so the app SP can use it.
WAREHOUSE_ID=""

# Unity Catalog location for the Act 4 gold + synced churn table.
# The app SP must be able to CREATE a schema/table in this catalog.
GOLD_CATALOG="main"
GOLD_SCHEMA="sales_ml"
